## The indifference engine parallelises its backward sweep with RcppParallel
## (see src/indiff_bellman.cpp).  CxxFlags() supplies the TBB include path and
## the RCPP_PARALLEL_USE_TBB define; LdFlags() links the bundled TBB runtime.
PKG_CXXFLAGS = $(shell "${R_HOME}/bin/Rscript" -e "RcppParallel::CxxFlags()")
PKG_LIBS = $(shell "${R_HOME}/bin/Rscript" -e "RcppParallel::LdFlags()")
