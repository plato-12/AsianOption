## The indifference engine parallelises its backward sweep with RcppParallel
## (see src/indiff_bellman.cpp).  On Windows the TBB backend is opt-in, so the
## define is given explicitly; LdFlags() links the RcppParallel TBB stub.
PKG_CXXFLAGS += -DRCPP_PARALLEL_USE_TBB=1
PKG_LIBS += $(shell "${R_HOME}/bin${R_ARCH_BIN}/Rscript.exe" -e "RcppParallel::LdFlags()")
